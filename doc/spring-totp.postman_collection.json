            "description": "Login kredensial dasar. Jika TOTP belum aktif, langsung mengembalikan `token` dan `refreshToken`. Jika TOTP aktif, mengembalikan `mfaRequired: true` dan `tempToken`."
          },
          "response": []
        },
        {
          "name": "3. Setup TOTP (Get QR Code & Secret)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Contains TOTP setup properties', function () {",
                  "    pm.expect(jsonData.data).to.have.property('secretKey');",
                  "    pm.expect(jsonData.data).to.have.property('qrCodeDataUrl');",
                  "    pm.expect(jsonData.data).to.have.property('manualUri');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.secretKey) {",
                  "    if (pm.environment) pm.environment.set('totpSecret', jsonData.data.secretKey);",
                  "    pm.collectionVariables.set('totpSecret', jsonData.data.secretKey);",
                  "    console.log('Saved totpSecret: ' + jsonData.data.secretKey);",
                  "}",
                  "",
                  "// Visualizer for Postman (renders QR code in Visualize tab)",
                  "var template = `",
                  "<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; text-align: center; padding: 25px; background: #f8f9fa;\">",
                  "    <div style=\"background: #ffffff; padding: 25px; display: inline-block; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); max-width: 400px;\">",
                  "        <h2 style=\"color: #2c3e50; margin-top: 0;\">🔐 Two-Factor Setup</h2>",
                  "        <p style=\"color: #7f8c8d; font-size: 14px;\">Scan gambar QR ini di aplikasi Authenticator (Google Authenticator, Authy, dll):</p>",
                  "        <div style=\"margin: 15px 0;\">",
                  "            <img src=\"{{qrCodeDataUrl}}\" alt=\"TOTP QR Code\" style=\"width: 220px; height: 220px; border: 1px solid #e1e8ed; border-radius: 8px;\" />",
                  "        </div>",
                  "        <div style=\"text-align: left; background: #edf2f7; padding: 12px; border-radius: 6px; font-size: 13px;\">",
                  "            <p style=\"margin: 0 0 5px 0;\"><strong>Secret Key:</strong></p>",
                  "            <code style=\"background: #ffffff; padding: 4px 8px; border-radius: 4px; display: block; font-family: monospace; font-size: 13px; color: #e74c3c; word-break: break-all;\">{{secretKey}}</code>",
                  "            <p style=\"margin: 10px 0 5px 0;\"><strong>Manual URI:</strong></p>",
                  "            <span style=\"color: #555; word-break: break-all; font-size: 11px;\">{{manualUri}}</span>",
                  "        </div>",
                  "    </div>",
                  "</div>",
                  "`;",
                  "",
                  "if (jsonData.data) {",
                  "    pm.visualizer.set(template, {",
                  "        qrCodeDataUrl: jsonData.data.qrCodeDataUrl,",
                  "        secretKey: jsonData.data.secretKey,",
                  "        manualUri: jsonData.data.manualUri",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/totp/setup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "totp",
                "setup"
              ]
            },
            "description": "Mengambil parameter setup TOTP: Secret Key (Base32), QR code data URI, dan URI manual. Membutuhkan Bearer Token. Hasil `secretKey` otomatis disimpan ke variabel `totpSecret` dan QR Code dapat dilihat di tab **Visualize**."
          },
          "response": []
        },
        {
          "name": "4. Enable TOTP (Activate 2FA)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Function to generate 6-digit TOTP code using built-in CryptoJS",
                  "function base32tohex(base32) {",
                  "    var base32chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "    var bits = '';",
                  "    var hex = '';",
                  "    base32 = base32.replace(/=+$/, '').toUpperCase().replace(/\\s+/g, '');",
                  "    for (var i = 0; i < base32.length; i++) {",
                  "        var val = base32chars.indexOf(base32.charAt(i));",
                  "        if (val === -1) continue;",
                  "        var b = val.toString(2);",
                  "        while (b.length < 5) b = '0' + b;",
                  "        bits += b;",
                  "    }",
                  "    for (var j = 0; j + 4 <= bits.length; j += 4) {",
                  "        var chunk = bits.substring(j, j + 4);",
                  "        hex += parseInt(chunk, 2).toString(16);",
                  "    }",
                  "    return hex;",
                  "}",
                  "",
                  "function generateTOTP(secret) {",
                  "    if (!secret) return null;",
                  "    var epoch = Math.floor(Date.now() / 1000);",
                  "    var counter = Math.floor(epoch / 30);",
                  "    var hexCounter = counter.toString(16);",
                  "    while (hexCounter.length < 16) hexCounter = '0' + hexCounter;",
                  "",
                  "    var key = CryptoJS.enc.Hex.parse(base32tohex(secret));",
                  "    var message = CryptoJS.enc.Hex.parse(hexCounter);",
                  "",
                  "    var hmac = CryptoJS.HmacSHA1(message, key);",
                  "    var hmacHex = hmac.toString(CryptoJS.enc.Hex);",
                  "",
                  "    var offset = parseInt(hmacHex.substring(hmacHex.length - 2), 16) & 0xf;",
                  "    var sub = hmacHex.substring(offset * 2, offset * 2 + 8);",
                  "    var binary = parseInt(sub, 16) & 0x7fffffff;",
                  "    var otp = (binary % 1000000).toString();",
                  "    while (otp.length < 6) otp = '0' + otp;",
                  "    return otp;",
                  "}",
                  "",
                  "var secret = pm.environment.get('totpSecret') || pm.collectionVariables.get('totpSecret');",
                  "if (secret) {",
                  "    var code = generateTOTP(secret);",
                  "    if (code) {",
                  "        if (pm.environment) pm.environment.set('totpCode', code);",
                  "        pm.collectionVariables.set('totpCode', code);",
                  "        console.log('Auto-calculated TOTP Code: ' + code);",
                  "    }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('TOTP successfully activated', function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.message).to.include('success enable totp');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{totpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/totp/enable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "totp",
                "enable"
              ]
            },
            "description": "Mengaktifkan TOTP dengan memverifikasi 6-digit kode OTP. Script pre-request otomatis menghitung kode OTP dari `totpSecret` jika tersedia."
          },
          "response": []
        },
        {
          "name": "5. Verify TOTP (Login Step 2)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Function to generate 6-digit TOTP code using built-in CryptoJS",
                  "function base32tohex(base32) {",
                  "    var base32chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "    var bits = '';",
                  "    var hex = '';",
                  "    base32 = base32.replace(/=+$/, '').toUpperCase().replace(/\\s+/g, '');",
                  "    for (var i = 0; i < base32.length; i++) {",
                  "        var val = base32chars.indexOf(base32.charAt(i));",
                  "        if (val === -1) continue;",
                  "        var b = val.toString(2);",
                  "        while (b.length < 5) b = '0' + b;",
                  "        bits += b;",
                  "    }",
                  "    for (var j = 0; j + 4 <= bits.length; j += 4) {",
                  "        var chunk = bits.substring(j, j + 4);",
                  "        hex += parseInt(chunk, 2).toString(16);",
                  "    }",
                  "    return hex;",
                  "}",
                  "",
                  "function generateTOTP(secret) {",
                  "    if (!secret) return null;",
                  "    var epoch = Math.floor(Date.now() / 1000);",
                  "    var counter = Math.floor(epoch / 30);",
                  "    var hexCounter = counter.toString(16);",
                  "    while (hexCounter.length < 16) hexCounter = '0' + hexCounter;",
                  "",
                  "    var key = CryptoJS.enc.Hex.parse(base32tohex(secret));",
                  "    var message = CryptoJS.enc.Hex.parse(hexCounter);",
                  "",
                  "    var hmac = CryptoJS.HmacSHA1(message, key);",
                  "    var hmacHex = hmac.toString(CryptoJS.enc.Hex);",
                  "",
                  "    var offset = parseInt(hmacHex.substring(hmacHex.length - 2), 16) & 0xf;",
                  "    var sub = hmacHex.substring(offset * 2, offset * 2 + 8);",
                  "    var binary = parseInt(sub, 16) & 0x7fffffff;",
                  "    var otp = (binary % 1000000).toString();",
                  "    while (otp.length < 6) otp = '0' + otp;",
                  "    return otp;",
                  "}",
                  "",
                  "var secret = pm.environment.get('totpSecret') || pm.collectionVariables.get('totpSecret');",
                  "if (secret) {",
                  "    var code = generateTOTP(secret);",
                  "    if (code) {",
                  "        if (pm.environment) pm.environment.set('totpCode', code);",
                  "        pm.collectionVariables.set('totpCode', code);",
                  "        console.log('Auto-calculated TOTP Code: ' + code);",
                  "    }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('TOTP verify success & tokens received', function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.have.property('token');",
                  "    pm.expect(jsonData.data).to.have.property('refreshToken');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    if (pm.environment) {",
                  "        pm.environment.set('accessToken', jsonData.data.token);",
                  "        pm.environment.set('refreshToken', jsonData.data.refreshToken);",
                  "    }",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.token);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "    console.log('TOTP verified! Saved accessToken and refreshToken.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tempToken\": \"{{tempToken}}\",\n  \"code\": \"{{totpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/totp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "totp",
                "verify"
              ]
            },
            "description": "Langkah kedua login jika TOTP aktif. Memvalidasi `tempToken` dan `code` (6 digit) untuk menghasilkan `accessToken` dan `refreshToken` final."
          },
          "response": []
        },
        {
