  "item": [
    {
      "name": "01. Authentication & TOTP",
      "description": "Endpoints untuk Registrasi, Login, MFA/TOTP setup & verify, Token Refresh, serta Logout.",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Register success status', function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"username\": \"janedoe\",\n  \"email\": \"janedoe@example.com\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Mendaftarkan user baru dengan role default USER dan `isTotpEnabled = false`."
          },
          "response": []
        },
        {
          "name": "2. Login (Primary Credential)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Response is successful', function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "",
                  "if (jsonData.data) {",
                  "    if (jsonData.data.mfaRequired === true) {",
                  "        pm.test('MFA is required: tempToken extracted', function () {",
                  "            pm.expect(jsonData.data.tempToken).to.be.a('string');",
                  "        });",
                  "        if (pm.environment) pm.environment.set('tempToken', jsonData.data.tempToken);",
                  "        pm.collectionVariables.set('tempToken', jsonData.data.tempToken);",
                  "        console.log('MFA is required. Saved tempToken.');",
                  "    } else if (jsonData.data.token) {",
                  "        pm.test('Direct login successful: tokens received', function () {",
                  "            pm.expect(jsonData.data.token).to.be.a('string');",
                  "        });",
                  "        if (pm.environment) {",
                  "            pm.environment.set('accessToken', jsonData.data.token);",
                  "            pm.environment.set('refreshToken', jsonData.data.refreshToken);",
                  "        }",
                  "        pm.collectionVariables.set('accessToken', jsonData.data.token);",
                  "        pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "        console.log('Login successful. Saved accessToken and refreshToken.');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
