                  "if (pm.environment) {",
                  "    pm.environment.set('accessToken', '');",
                  "    pm.environment.set('tempToken', '');",
                  "}",
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('tempToken', '');",
                  "console.log('Logged out. Cleared token variables.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
